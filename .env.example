# Shiftly environment template — copy to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is gitignored; this template is safe to commit (no secrets).

# ── Supabase (Project Settings → API) — required to boot
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (Clerk dashboard → API Keys) — required to boot
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── App URL (use http://localhost:3000 for local dev)
NEXT_PUBLIC_APP_URL=

# ── Stripe — billing/checkout only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Base (£49 Manual) prices
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=
# AI-supported (£59) prices — shown on checkout; trials start on the monthly one
NEXT_PUBLIC_STRIPE_PRICE_AI_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_AI_ANNUAL=
# Server-side: comma-separated AI price ids that grant the agent (usually the two above)
STRIPE_AI_PRICE_IDS=

# ── Anthropic — AI companion (Q&A + agent)
ANTHROPIC_API_KEY=

# ── Resend — outbound email only
RESEND_API_KEY=

# ── Python OR-Tools scheduler (Railway URL) — rota generation
PYTHON_SCHEDULER_URL=
